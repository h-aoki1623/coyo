{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "tool == \"Bash\" && tool_input.command matches \"git\\\\s+commit\"",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-no-verify.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-commit-test-reminder.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "tool == \"Edit|Write|MultiEdit\" && tool_input.file_path matches \"\\\\.(ts|tsx|js|jsx)$\"",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-typescript-lint.sh"
          }
        ]
      },
      {
        "matcher": "tool == \"Edit|Write|MultiEdit\" && tool_input.file_path matches \"\\\\.py$\"",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-python-lint.sh"
          }
        ]
      }
    ]
  }
}
