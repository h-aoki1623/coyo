# Supply-chain defense: refuse to install any package version that was
# published less than 7 days ago. This cooldown gives the wider community
# time to detect malicious releases (e.g., the 2025 axios hijack) before
# they land in our dependency tree.
#
# Requires npm >= 11.10.0 (the version that introduced `min-release-age`).
# engine-strict=true makes `npm ci` HARD-FAIL on older npm instead of
# silently ignoring the setting and disabling the cooldown (fail-closed).
#
# `min-release-age` is an INTEGER number of days (npm CLI source:
# workspaces/config/lib/definitions/definitions.js — type [null, Number]).
# Keep this value in sync with UV_COOLDOWN_DAYS in scripts/uv-install.sh.
engine-strict=true
min-release-age=7
